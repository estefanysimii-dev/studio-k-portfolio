DirectoryIndex index.php
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://studiokatelier.infinityfreeapp.com%{REQUEST_URI} [R=302,L]
RewriteRule ^(?:template\.html|index\.html)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
